{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://historical-cartography-research-advisor/schemas/skill.schema.json",
  "title": "Skill Registry Entry",
  "description": "Schema for a skill registered in the Historical Cartography Research Advisor registry (SKILL.md manifest).",
  "type": "object",
  "required": ["name", "version", "description", "sub_advisors", "tools", "hooks", "disclaimer_required"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "domain": { "type": "string" },
    "disclaimer_required": { "type": "boolean" },
    "sub_advisors": {
      "type": "array",
      "items": { "$ref": "#/$defs/subAdvisorRef" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolRef" }
    },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hookRef" }
    },
    "references": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "subAdvisorRef": {
      "type": "object",
      "required": ["id", "name", "methodologies"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "methodologies": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "references": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "toolRef": {
      "type": "object",
      "required": ["name", "description", "parameters", "output"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "parameters": { "type": "object" },
        "output": { "type": "object" }
      }
    },
    "hookRef": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "events": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
